# ─────────────────────────────────────────────────────────────
# LeadForge — Environment Variables
# Copy this file to .env.local for local dev, or set on Render.
# Required keys marked with ★
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
# ★ Full public URL (no trailing slash). Set this on Render after deploy.
APP_URL=https://your-app.onrender.com

# Directory where the JSON data store is kept (Render: mounted disk)
DATA_DIR=/var/data/leadforge

# ── AI (both have free tiers) ────────────────────────────────
# ★ Google Gemini — free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq (free fallback) — key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── Payments ─────────────────────────────────────────────────
# Flutterwave — key at https://dashboard.flutterwave.com/settings/apis
# Test key works end-to-end in sandbox mode
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# ── Email / SMTP ─────────────────────────────────────────────
# No keys needed here — add your SMTP account inside the app
# at Settings → Email. Works with Gmail App Password, Outlook,
# or any SMTP provider. No OAuth needed.

# ── Google OAuth (optional — only for Gmail OAuth) ───────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft OAuth (optional — only for Outlook OAuth) ──────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Security (auto-generated by Render's generateValue) ──────
# Generate locally with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-random-64-char-hex-string
APP_ENCRYPTION_KEY=change-this-to-a-different-random-64-char-hex-string

# ── Scheduler ────────────────────────────────────────────────
# If set, GET /api/scheduler/tick requires this as ?secret= param.
# UptimeRobot URL: https://your-app.onrender.com/api/scheduler/tick?secret=YOUR_SECRET
# Render cron calls this every minute automatically.
SCHEDULER_SECRET=
