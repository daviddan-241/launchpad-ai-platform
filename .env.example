# ─────────────────────────────────────────────────────────────
# LeadForge — Environment Variables
# Copy this file to .env.local for local dev, or set on Render.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
# Full public URL of your deployed app (no trailing slash)
APP_URL=https://your-app.onrender.com

# Directory where the JSON data store is kept (Render: use a mounted disk)
DATA_DIR=/var/data/leadforge

# ── AI (free tiers) ──────────────────────────────────────────
# Google Gemini — get free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq (free fallback) — get free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── Payments ─────────────────────────────────────────────────
# Flutterwave — get secret key at https://dashboard.flutterwave.com/settings/apis
# The free test key works end-to-end in sandbox mode
FLUTTERWAVE_SECRET_KEY=

# ── Email / SMTP ─────────────────────────────────────────────
# No keys needed here — add your SMTP account inside the app at Settings → Email.
# Supports Gmail App Password, Outlook, or any SMTP provider.

# ── Google OAuth (optional — only needed for Gmail OAuth login) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft OAuth (optional — only needed for Outlook OAuth login) ──
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Security (auto-generated on Render) ──────────────────────
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-random-64-char-hex-string
APP_ENCRYPTION_KEY=change-this-to-a-different-random-64-char-hex-string

# ── Scheduler (optional) ─────────────────────────────────────
# If set, GET /api/scheduler/tick requires this as ?secret= or x-scheduler-secret header.
# Render cron URL: https://your-app.onrender.com/api/scheduler/tick?secret=your-secret
SCHEDULER_SECRET=
