# ─────────────────────────────────────────────────────────────
# LeadForge — Environment Variables
# Only APP_URL and AI keys are needed. Everything else is optional
# or auto-generated on first boot.
# ─────────────────────────────────────────────────────────────

# ★ Your deployed URL (no trailing slash). Set this in Render.
APP_URL=https://your-app.onrender.com

# JSON data storage path. On Render this is a mounted disk.
DATA_DIR=/var/data/leadforge

# ── AI ───────────────────────────────────────────────────────
# ★ Google Gemini — FREE key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq fallback — FREE key: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── Payments (optional) ──────────────────────────────────────
# Flutterwave: https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# ── Email ────────────────────────────────────────────────────
# No env var needed — add SMTP inside the app at Settings → Email.

# ── Security ─────────────────────────────────────────────────
# AUTO-GENERATED on first boot if not set. You do NOT need to
# set these manually. LeadForge writes them to DATA_DIR/secrets.json
# and reuses them across restarts.
SESSION_SECRET=
APP_ENCRYPTION_KEY=
SCHEDULER_SECRET=
